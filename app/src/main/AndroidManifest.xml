<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        意図的に requestしない権限:
        - android.permission.MODIFY_AUDIO_ROUTING: protection levelが
          signature|privileged|role のため通常アプリには付与されない。
          実際の特権呼び出しは Shizuku 経由 (shell UID) で行うため、
          このアプリ自身のプロセスがこの権限を保持する必要はない。
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 導入済みShizukuの起動先だけを照会する。全アプリ一覧の権限は不要。 -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:name=".CameraSoundAssistApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CameraMuteAssist">

        <!-- Shizuku公式ドキュメント記載のとおりに宣言する ContentProvider。 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CameraMuteAssist">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".timer.RestoreBroadcastReceiver"
            android:exported="false" />

        <service
            android:name=".tile.CameraSoundAssistTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_camera_mute"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
